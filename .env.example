# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SARVAM_API_KEY=
# Optional: a bulbul:v3 voice name; empty uses the plugin default
SARVAM_SPEAKER=

# Needed for `python agent.py dev` (LiveKit Cloud or self-hosted), not for console mode
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Outbound calling stays OFF until TRAI DLT registration, a 140-series number and DND scrubbing are done
ALLOW_OUTBOUND=0
SIP_OUTBOUND_TRUNK_ID=
